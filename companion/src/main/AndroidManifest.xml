<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only to reach the head unit's adbd on the local network (after the bridge). Nothing else goes online. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- This phone is the USB host for the head unit (OTG). -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="CYHU Companion"
        android:supportsRtl="true"
        android:theme="@style/CompanionTheme"
        tools:ignore="GoogleAppIndexingWarning,DataExtractionRules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Offer to open when a head unit with USB debugging is plugged in. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/adb_device_filter" />
        </activity>
    </application>
</manifest>
